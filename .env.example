# Apify API token — https://console.apify.com/settings/integrations
APIFY_TOKEN=

# Backend portu (frontend Vite 5173'te çalışır ve /api isteklerini buraya yönlendirir)
PORT=5174

# Kullanılan Apify aktörleri (değiştirmek isterseniz "kullanici/aktor-adi" formatında yazın)
TRENDYOL_ACTOR=memo23/trendyol-scraper
LENS_ACTOR=johnvc/google-lens-api
META_ADS_ACTOR=apify/facebook-ads-scraper

# İsteğe bağlı: Trendyol aktörüne gönderilecek ek input (JSON). Örn: {"useResidentialProxy":true}
TRENDYOL_INPUT_EXTRA=
